(kicad_pcb (version 20241229) (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user))
  (setup
    (pad_to_mask_clearance 0.2)
    (tenting none))
  (net 0 "")
  (footprint "Synthetic:FrontPads" (layer "F.Cu") (at 5 5 90)
    (pad "1" thru_hole circle (at 1 0) (size 2 2)
      (drill 1 (offset 0.25 0)) (layers "*.Cu" "*.Mask"))
    (pad "2" smd rect (at 4 0) (size 2 1) (layers "F.Cu" "F.Mask")
      (solder_mask_margin 0.3))
    (pad "3" smd oval (at 0 4 90) (size 3 1) (layers "F.Cu" "F.Mask"))
    (pad "4" smd roundrect (at 4 4) (size 2 2) (layers "F.Cu" "F.Mask")
      (roundrect_rratio 0.25)))
  (footprint "Synthetic:BackPads" (layer "B.Cu") (at 25 5 90)
    (solder_mask_margin 0.4)
    (pad "1" smd circle (at 1 0) (size 2 2) (layers "B.Cu" "B.Mask"))
    (pad "2" thru_hole oval (at 0 2 45) (size 2 1)
      (drill oval 0.6 1.2 (offset 0.2 0)) (layers "*.Cu" "*.Mask")))
  (via (at 10 15) (size 1.2) (drill 0.6) (layers "F.Cu" "B.Cu") (net 0))
  (gr_circle (center 6 15) (end 7 15)
    (stroke (width 0.1) (type default)) (fill none) (layer "F.Mask"))
  (gr_rect (start 23 14) (end 25 16)
    (stroke (width 0.2) (type default)) (fill solid) (layer "B.Mask"))
  (gr_rect (start 0 0) (end 30 20)
    (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
  (gr_circle (center 15 10) (end 17 10)
    (stroke (width 0.05) (type default)) (fill none) (layer "Edge.Cuts"))
)
