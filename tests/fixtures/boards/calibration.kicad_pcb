(kicad_pcb (version 20241229) (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "b.silkscreen")
    (37 "F.SilkS" user "f.silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (44 "Edge.Cuts" user))
  (setup (pad_to_mask_clearance 0.1))
  (net 0 "")
  (footprint "Synthetic:CalibrationPad" (layer "F.Cu") (at 30 20)
    (pad "1" thru_hole circle (at 0 0) (size 4 4) (drill 2) (layers "*.Cu" "*.Mask")))
  (gr_line (start 0 0) (end 60 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 60 0) (end 60 40) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 60 40) (end 0 40) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
  (gr_line (start 0 40) (end 0 0) (stroke (width 0.05) (type default)) (layer "Edge.Cuts"))
)
